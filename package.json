{
  "name": "elementor-json-lab",
  "version": "0.2.0",
  "private": true,
  "description": "Elementor JSON validation, official import roundtrip, and cross-browser visual preview pipeline",
  "scripts": {
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "test:unit": "python -m unittest discover -s tests -p 'test_*.py' -v",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@wordpress/env": "11.11.0"
  }
}
