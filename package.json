{
  "name": "elementor-json-lab",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "description": "Elementor JSON validation, official-import roundtrip and cross-browser preview pipeline",
  "scripts": {
    "postinstall": "node tools/patch_wp_env_simple_git.cjs",
    "test:wp-env-git-compat": "node tools/patch_wp_env_simple_git.cjs --self-test",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "test:contracts": "python tools/validate_repo_contracts.py",
    "test:unit": "python tools/validate_repo_contracts.py && python -m unittest discover -s tests -p 'test_*.py' -v",
    "test:visual": "playwright test",
    "audit:deps": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@wordpress/env": "12.0.0"
  },
  "overrides": {
    "argparse": "2.0.1",
    "adm-zip": "0.6.1",
    "brace-expansion": "2.1.7",
    "body-parser": "1.20.9",
    "fast-uri": "3.1.9",
    "http-cache-semantics": "4.3.0",
    "qs": "6.17.1",
    "simple-git": "4.0.2"
  }
}
