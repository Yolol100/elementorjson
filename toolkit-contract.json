{
  "schema_version": "1.1",
  "owner_skill": "elementor",
  "project_id": "project-elementor",
  "repository": "Yolol100/elementorjson",
  "evidence_role": "controlled_runtime_elementor_json_visual_target_render_and_native_kit_validation",
  "requires_account": false,
  "requires_api_key": false,
  "requires_mcp": false,
  "tools": [
    {
      "id": "elementor-json-auditor",
      "version": "repo",
      "trigger_when": "templates are supplied",
      "outputs": [
        "artifacts/static-audit",
        "artifacts/runtime-audit"
      ]
    },
    {
      "id": "deep-json-validator",
      "version": "repo",
      "trigger_when": "templates are supplied",
      "outputs": [
        "deep validation reports"
      ]
    },
    {
      "id": "page-composition-auditor",
      "version": "repo",
      "trigger_when": "templates or optional design/content sidecars are supplied",
      "outputs": [
        "artifacts/composition-audit"
      ]
    },
    {
      "id": "visual-target-builder",
      "version": "repo",
      "trigger_when": "Elementor JSON is supplied and a whole-page visual model is needed",
      "outputs": [
        "artifacts/visual-targets"
      ]
    },
    {
      "id": "visual-target-validator",
      "version": "repo",
      "trigger_when": "a visual-target artifact is generated",
      "outputs": [
        "fail-closed source-prediction contract result"
      ]
    },
    {
      "id": "npm-audit",
      "version": "runner-node",
      "trigger_when": "every runtime preview",
      "outputs": [
        "artifacts/dependency-audit/npm-audit.json"
      ]
    },
    {
      "id": "wp-env",
      "version": "11.15.0",
      "trigger_when": "runtime evidence is required",
      "outputs": [
        "controlled WordPress runtime"
      ]
    },
    {
      "id": "elementor-core",
      "version": "4.3.1",
      "trigger_when": "runtime evidence is required",
      "outputs": [
        "runtime inventory and imports"
      ]
    },
    {
      "id": "hello-elementor",
      "version": "3.5.1",
      "trigger_when": "runtime evidence is required",
      "outputs": [
        "controlled render baseline"
      ]
    },
    {
      "id": "template-library-import",
      "version": "elementor-cli",
      "trigger_when": "templates are supplied to runtime",
      "outputs": [
        "official import evidence"
      ]
    },
    {
      "id": "semantic-roundtrip",
      "version": "repo",
      "trigger_when": "templates are imported",
      "outputs": [
        "artifacts/roundtrip"
      ]
    },
    {
      "id": "native-kit-customization-bridge",
      "version": "repo",
      "trigger_when": "exact-runtime native V4 Classes/Variables or mixed Website Template export/import evidence is required",
      "outputs": [
        "native Elementor Website Template ZIPs",
        "native customization export/import reports",
        "same-site media identity evidence"
      ]
    },
    {
      "id": "playwright",
      "version": "1.63.0",
      "trigger_when": "rendered runtime evidence is required",
      "outputs": [
        "cross-browser responsive screenshots",
        "DOM layout snapshots"
      ]
    }
  ],
  "usage_assertions": [
    {
      "tool": "elementor-json-auditor",
      "path": ".github/workflows/validate.yml",
      "contains": "audit_elementor_json.py"
    },
    {
      "tool": "deep-json-validator",
      "path": ".github/workflows/validate.yml",
      "contains": "validate_elementor_deep.py"
    },
    {
      "tool": "page-composition-auditor",
      "path": ".github/workflows/composition-contract.yml",
      "contains": "audit_page_composition.py"
    },
    {
      "tool": "visual-target-builder",
      "path": ".github/workflows/composition-contract.yml",
      "contains": "build_visual_target.py"
    },
    {
      "tool": "visual-target-validator",
      "path": ".github/workflows/composition-contract.yml",
      "contains": "validate_visual_target.py"
    },
    {
      "tool": "npm-audit",
      "path": ".github/workflows/validate.yml",
      "contains": "npm audit --audit-level=high"
    },
    {
      "tool": "wp-env",
      "path": "package.json",
      "contains": "\"@wordpress/env\": \"11.15.0\""
    },
    {
      "tool": "wp-env",
      "path": ".wp-env.json",
      "contains": "WordPress/WordPress#7.1.2"
    },
    {
      "tool": "wp-env",
      "path": ".wp-env.json",
      "contains": "\"phpVersion\": \"8.3\""
    },
    {
      "tool": "elementor-core",
      "path": ".github/workflows/validate.yml",
      "contains": "ELEMENTOR_CORE_VERSION: '4.3.1'"
    },
    {
      "tool": "hello-elementor",
      "path": ".github/workflows/validate.yml",
      "contains": "HELLO_ELEMENTOR_VERSION: '3.5.1'"
    },
    {
      "tool": "template-library-import",
      "path": ".github/workflows/validate.yml",
      "contains": "elementor library import"
    },
    {
      "tool": "semantic-roundtrip",
      "path": ".github/workflows/validate.yml",
      "contains": "compare_elementor_roundtrip.py"
    },
    {
      "tool": "native-kit-customization-bridge",
      "path": "wordpress-plugin/elementor-json-lab/includes/class-cli-command.php",
      "contains": "get_component( 'import-export-customization' )"
    },
    {
      "tool": "native-kit-customization-bridge",
      "path": ".github/workflows/native-kit-contract.yml",
      "contains": "ejl native_kit_export"
    },
    {
      "tool": "native-kit-customization-bridge",
      "path": ".github/workflows/native-kit-contract.yml",
      "contains": "ejl native_kit_import"
    },
    {
      "tool": "playwright",
      "path": "package.json",
      "contains": "\"@playwright/test\": \"1.63.0\""
    },
    {
      "tool": "playwright",
      "path": "tests/e2e/preview.spec.js",
      "contains": "layout_snapshot"
    }
  ],
  "boundaries": [
    "The visual-target builder and validator are source_prediction only: explicit/declared/inferred/unknown values never become browser observations by themselves.",
    "The accountless Free/Core path is complete without Elementor Pro.",
    "Elementor Pro remains an optional pre-existing secret/license path; this hardening does not add or require a new account, API key or MCP server.",
    "The native-kit customization bridge invokes Elementor's own runtime component and registered runners; it does not define a parallel ZIP format and supports claims only for the exact runtime and feature states proven by the workflow.",
    "Portable Elementor imports may remap media IDs; same-site existing-media reuse must preserve and live-validate the WordPress id+url pair.",
    "Controlled runtime evidence does not prove a client staging or production target.",
    "Accessibility acceptance remains owned by Website QA.",
    "Usage assertions require registered tool IDs and non-empty typed fields; paths must resolve inside this repository and never traverse or escape through symlinks."
  ]
}
